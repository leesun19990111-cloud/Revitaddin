<Window x:Class="WallSplitter.QuickToggleSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="커스텀 버튼 설정"
        Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">
    <!-- 다크 테마는 이 창의 Resources에만 로컬로 병합한다 - Application 리소스에 병합하면 Revit 리본/다른
         애드인 UI까지 우리 스타일이 번져 텍스트가 하얗게 되는 라이브 버그가 있었다(NamerWindow.xaml 참고). -->
    <Window.Resources>
        <ResourceDictionary Source="/WallSplitter;component/Resources/Theme.xaml"/>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="현재 뷰에서 원클릭으로 켜고 끌 뷰템플릿/필터/작업세트 버튼을 등록합니다. 같은 종류라도 이름을 다르게 지정해 여러 버튼을 추가할 수 있습니다.&#10;'프리셋' 버튼은 뷰템플릿+필터+작업세트를 원하는 조합으로 한 버튼에 담아 한 번에 켜고 끕니다.&#10;이 설정은 이 PC의 이 프로젝트 파일에만 저장되며, 다른 프로젝트 파일에는 영향을 주지 않습니다."/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource SurfaceBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ButtonListPanel" Margin="4"/>
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <Button x:Name="AddViewTemplateButton" Content="+ 뷰템플릿 버튼 추가" Padding="6,4" Margin="0,0,0,4" Click="AddViewTemplateButton_Click"/>
                    <Button x:Name="AddFilterButton" Content="+ 필터 버튼 추가" Padding="6,4" Margin="0,0,0,4" Click="AddFilterButton_Click"/>
                    <Button x:Name="AddWorksetButton" Content="+ 작업세트 버튼 추가" Padding="6,4" Margin="0,0,0,4" Click="AddWorksetButton_Click"/>
                    <Button x:Name="AddPresetButton" Content="+ 프리셋 버튼 추가" Padding="6,4" Margin="0,0,0,4" Click="AddPresetButton_Click"/>
                    <Button x:Name="AddColorToolButton" Content="+ 색상 버튼 추가" Padding="6,4" Click="AddColorToolButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- 이름/카테고리 표시는 위쪽에 고정하고(EditHeaderHost), 대상 목록만 아래에서 스크롤되게
                 나눴다 - 뷰템플릿이 많아 목록이 길어지면 스크롤을 내렸을 때 이름 변경 칸이 같이 사라져서
                 안 보이는 문제가 있었다(2026-07-27 실측 피드백). -->
            <Border Grid.Column="2" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource SurfaceBrush}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="EditHeaderHost" Grid.Row="0"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="EditPanelHost"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="커스텀 버튼 툴바는 빈 곳을 눌러 드래그하면 원하는 위치로 옮길 수 있습니다. '모델로'는 같은 Revit 세션에 열려 있는 다른 프로젝트와 직접 주고받으며, 대상 문서에 없는 뷰템플릿/필터를 실제로 복사해 옵니다(JSON은 이름만 다시 찾습니다)."
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <WrapPanel>
                <Button x:Name="ResetPositionButton" Content="위치 초기화" Padding="10,4" Margin="0,0,6,6" Click="ResetPositionButton_Click"/>
                <Button x:Name="ExportJsonButton" Content="JSON으로 내보내기" Padding="10,4" Margin="10,0,6,6" Click="ExportJsonButton_Click"/>
                <Button x:Name="ImportJsonButton" Content="JSON에서 가져오기" Padding="10,4" Margin="0,0,6,6" Click="ImportJsonButton_Click"/>
                <Button x:Name="ExportToModelButton" Content="모델로 내보내기" Padding="10,4" Margin="10,0,6,6" Click="ExportToModelButton_Click"/>
                <Button x:Name="ImportFromModelButton" Content="모델에서 가져오기" Padding="10,4" Margin="0,0,6,6" Click="ImportFromModelButton_Click"/>
            </WrapPanel>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="취소" Padding="18,5" Margin="0,0,8,0" Click="CancelButton_Click" IsCancel="True"/>
            <Button Content="저장" Padding="18,5" Click="SaveButton_Click" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
