<Window x:Class="WallSplitter.QuickToggleSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="커스텀 버튼 설정"
        Height="800" Width="1020" MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        PreviewKeyDown="Window_PreviewKeyDown">
    <!-- 테마는 이 창의 Resources에만 로컬로 병합한다 - Application 리소스에 병합하면 Revit 리본/다른
         애드인 UI까지 우리 스타일이 번져 텍스트가 하얗게 되는 라이브 버그가 있었다(NamerWindow.xaml 참고). -->
    <Window.Resources>
        <ResourceDictionary Source="/WallSplitter;component/Resources/Theme.xaml"/>
    </Window.Resources>

    <!--
        2026-09-03 UX 전면 개편. 이전 구조는 "왼쪽 목록 + 오른쪽 편집" 2단에 상단 4줄짜리 설명 문단,
        왼쪽 아래에 설명 없는 '+ ○○ 버튼 추가' 7개가 나열된 형태였다 - 처음 쓰는 사람은 어떤 버튼인지
        모르는 채로 눌러야 했고("모르는 사람이 쓰기엔 너무 어렵다"는 2026-09-02 피드백과 같은 문제),
        만든 버튼이 실제 툴바에서 어떻게 보일지도 저장하기 전엔 알 수 없었다. 새 구조는
        (1) 맨 위 "툴바 미리보기" 띠 - 실제 QuickToggleToolbar와 같은 시각 규칙으로 그려서 저장 전에 확인,
        (2) 2단 본문 - 왼쪽 목록 + 오른쪽 ①이름 ②모양 ③대상 단계형 편집,
        (3) 카드형 "버튼 종류 선택" 오버레이 - 종류마다 한 줄 설명을 붙여 고르는 순간 이해되게,
        (4) 접이식 "고급" - 내보내기/가져오기/툴바 위치처럼 가끔 쓰는 것을 평소엔 감춤.
        시각 언어는 기존 Industry 디자인 시스템 그대로다(스틸블루 단일 강조색, 모서리 반지름 0,
        얇은 실선 테두리, 채워진 오브젝트는 주 버튼과 강조 뱃지뿐) - docs/design-system/CLAUDE.md 참고.
    -->
    <!-- 바깥 Grid는 본문 위에 "버튼 종류 선택" 오버레이를 겹치기 위한 것. -->
    <Grid>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== 제목 ===== -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="커스텀 버튼 설정" FontSize="19" FontWeight="Bold"/>
                <TextBlock Margin="0,3,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="Revit 화면에 떠 있는 커스텀 버튼바에 넣을 버튼을 만들고 순서를 정합니다. 이 설정은 이 PC에 저장되어 어떤 프로젝트를 열어도 그대로 유지되며, 대상(뷰템플릿·필터·작업세트)은 열려 있는 프로젝트에서 같은 이름으로 다시 찾습니다."/>
            </StackPanel>

            <!-- ===== 툴바 미리보기 ===== -->
            <!-- 카드 배경은 창 바탕색(WindowBackground)으로 둔다 - 안에 그리는 툴바 미리보기 자체가
                 실제 툴바와 같은 SurfaceBrush 배경이라, 카드까지 Surface면 툴바 테두리가 묻혀 보인다. -->
            <Border Grid.Row="1" Margin="0,0,0,12" Padding="12,10,12,10"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                <!-- PreviewCard: 코드비하인드가 Industry 디자인 시스템의 .blueprint 모서리 등록 마크를 여기에 얹는다. -->
                <Grid x:Name="PreviewCard">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="툴바 미리보기" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                       Text="켜고 끄는 버튼은 '켜졌을 때'의 모습입니다. 버튼을 클릭하면 오른쪽에서 편집합니다."/>
                        </Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="PreviewPanel" Orientation="Horizontal"/>
                        </ScrollViewer>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== 본문: 왼쪽 목록 / 오른쪽 편집 ===== -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="등록된 버튼" FontWeight="Bold" Margin="0,0,0,6"/>

                    <Border Grid.Row="1" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                            Background="{DynamicResource SurfaceBrush}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ButtonListPanel" Margin="2"/>
                        </ScrollViewer>
                    </Border>

                    <Button Grid.Row="2" x:Name="AddButton" Content="+ 버튼 추가" Margin="0,8,0,0"
                            Padding="10,7" Click="AddButton_Click"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </Grid>

                <!-- 제목/이름/모양/대상 헤더는 위쪽에 고정하고(EditHeaderHost), 대상 목록만 아래에서
                     스크롤되게 나눈다 - 목록이 길어져도 이름 칸과 검색창이 항상 보이게 하기 위함
                     (2026-07-27 실측 피드백: "스크롤을 내리면 이름 변경 부분이 같이 사라진다"). -->
                <Border Grid.Column="2" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                        Background="{DynamicResource SurfaceBrush}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="EditHeaderHost" Grid.Row="0"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="EditPanelHost"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== 고급 (접이식) ===== -->
            <Border Grid.Row="3" x:Name="AdvancedPanel" Visibility="Collapsed" Margin="0,12,0,0" Padding="12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="JSON 내보내기/가져오기는 다른 PC로 이 설정을 옮길 때 씁니다. 가져온 버튼은 기존 버튼을 지우지 않고 뒤에 추가되며, 대상은 파일에 담긴 이름으로 다시 찾으므로 그 이름의 뷰템플릿·필터·작업세트가 있는 프로젝트에서 동작합니다."/>
                    <WrapPanel>
                        <Button x:Name="ExportJsonButton" Content="JSON으로 내보내기" Padding="10,5" Margin="0,0,6,6" Click="ExportJsonButton_Click"/>
                        <Button x:Name="ImportJsonButton" Content="JSON에서 가져오기" Padding="10,5" Margin="0,0,16,6" Click="ImportJsonButton_Click"/>
                        <Button x:Name="ResetPositionButton" Content="툴바 위치 초기화" Padding="10,5" Margin="0,0,0,6" Click="ResetPositionButton_Click"/>
                    </WrapPanel>
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="커스텀 버튼바는 왼쪽 손잡이를 잡고 드래그해 옮길 수 있습니다. 화면 밖으로 나가 다시 잡을 수 없을 때 '툴바 위치 초기화'를 쓰세요(이 버튼만 '저장'과 무관하게 즉시 적용됩니다)."/>
                </StackPanel>
            </Border>

            <!-- ===== 푸터 ===== -->
            <Grid Grid.Row="4" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="AdvancedToggleButton" Click="AdvancedToggleButton_Click"
                        Background="Transparent" BorderThickness="0" Padding="0,4" Cursor="Hand"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="AdvancedGlyphHost" Width="10" Height="10" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AdvancedToggleText" Margin="6,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="취소" Padding="20,6" Margin="0,0,8,0" Click="CancelButton_Click" IsCancel="True"/>
                    <Button Content="저장" Padding="24,6" Click="SaveButton_Click" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ===== 버튼 종류 선택 오버레이 =====
             "+ 버튼 추가"를 누르면 본문 위에 겹쳐 뜬다. 종류마다 실제 기본 아이콘과 "이 버튼이 무슨 일을
             하는지" 한 줄 설명을 함께 보여줘서, 예전처럼 이름만 보고 짐작해서 고르지 않아도 되게 했다. -->
        <Grid x:Name="AddOverlay" Visibility="Collapsed" Background="#661D1F20">
            <Border MaxWidth="770" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="어떤 버튼을 만들까요?" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="닫기" Padding="12,4" Click="CloseAddOverlayButton_Click"/>
                    </Grid>
                    <TextBlock Margin="0,0,0,14" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="종류만 고르면 됩니다. 이름·아이콘·색과 대상은 만든 뒤에 얼마든지 바꿀 수 있습니다."/>
                    <WrapPanel x:Name="AddChooserPanel"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
