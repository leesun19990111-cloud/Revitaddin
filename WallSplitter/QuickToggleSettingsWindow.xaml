<Window x:Class="WallSplitter.QuickToggleSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="빠른 토글 설정"
        Height="620" Width="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">
    <!-- 다크 테마는 이 창의 Resources에만 로컬로 병합한다 - Application 리소스에 병합하면 Revit 리본/다른
         애드인 UI까지 우리 스타일이 번져 텍스트가 하얗게 되는 라이브 버그가 있었다(NamerWindow.xaml 참고). -->
    <Window.Resources>
        <ResourceDictionary Source="/WallSplitter;component/Resources/Theme.xaml"/>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="현재 뷰에서 원클릭으로 켜고 끌 뷰템플릿/필터/작업세트 버튼을 등록합니다. 같은 종류라도 이름을 다르게 지정해 여러 버튼을 추가할 수 있습니다.&#10;이 설정은 이 PC의 이 프로젝트 파일에만 저장되며, 다른 프로젝트 파일에는 영향을 주지 않습니다."/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource SurfaceBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ButtonListPanel" Margin="4"/>
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <Button x:Name="AddViewTemplateButton" Content="+ 뷰템플릿 버튼 추가" Padding="6,4" Margin="0,0,0,4" Click="AddViewTemplateButton_Click"/>
                    <Button x:Name="AddFilterButton" Content="+ 필터 버튼 추가" Padding="6,4" Margin="0,0,0,4" Click="AddFilterButton_Click"/>
                    <Button x:Name="AddWorksetButton" Content="+ 작업세트 버튼 추가" Padding="6,4" Click="AddWorksetButton_Click"/>
                </StackPanel>
            </Grid>

            <Border Grid.Column="2" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource SurfaceBrush}" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="EditPanelHost"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
            <TextBlock Text="빠른 토글 툴바는 빈 곳을 눌러 드래그하면 원하는 위치로 옮길 수 있습니다."
                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            <Button x:Name="ResetPositionButton" Content="위치 초기화" Padding="10,4" Margin="10,0,0,0" Click="ResetPositionButton_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="취소" Padding="18,5" Margin="0,0,8,0" Click="CancelButton_Click" IsCancel="True"/>
            <Button Content="저장" Padding="18,5" Click="SaveButton_Click" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
