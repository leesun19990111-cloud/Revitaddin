<Window x:Class="WallSplitter.ElementPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="대상 선택"
        Height="480" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">
    <!-- 다크 테마는 이 창의 Resources에만 로컬로 병합한다 - Application 리소스에 병합하면 Revit 리본/다른
         애드인 UI까지 우리 스타일이 번져 텍스트가 하얗게 되는 라이브 버그가 있었다(NamerWindow.xaml 참고). -->
    <Window.Resources>
        <ResourceDictionary Source="/WallSplitter;component/Resources/Theme.xaml"/>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" TextWrapping="Wrap" FontWeight="Bold" Margin="0,0,0,10"/>

        <TextBox x:Name="FilterBox" Grid.Row="1" Margin="0,0,0,8" VerticalContentAlignment="Center"
                 TextChanged="FilterBox_TextChanged"/>

        <Border Grid.Row="2" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6">
            <ListBox x:Name="CandidateList" BorderThickness="0"
                     SelectionChanged="CandidateList_SelectionChanged"
                     MouseDoubleClick="CandidateList_MouseDoubleClick"/>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="취소 (이 문서 전체 건너뜀)" Padding="18,5" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button Content="이 항목만 건너뛰기" Padding="18,5" Margin="0,0,8,0" Click="SkipButton_Click"/>
            <Button x:Name="OkButton" Content="선택 완료" Padding="18,5" Click="OkButton_Click" IsEnabled="False" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
