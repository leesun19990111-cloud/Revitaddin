<Window x:Class="WallSplitter.RoomSeparatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="룸 구분선 자동 생성"
        Height="680" Width="920" MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">
    <!-- 테마는 이 창의 Resources에만 로컬로 병합한다 - Application 리소스에 병합하면 Revit 리본/다른
         애드인 UI까지 우리 스타일이 번져 텍스트가 하얗게 되는 라이브 버그가 있었다(NamerWindow.xaml 참고). -->
    <Window.Resources>
        <ResourceDictionary Source="/WallSplitter;component/Resources/Theme.xaml"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 제목 ===== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="룸 구분선 자동 생성" FontSize="19" FontWeight="Bold"/>
            <TextBlock Margin="0,3,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="고른 벽 유형의 벽을 찾아 그 벽의 중심선 위에 룸 구분선을 만듭니다. 링크된 모델의 벽도 함께 대상으로 삼을 수 있습니다. 벽의 위치선이 마감면·코어면으로 그려져 있어도 벽 두께를 계산해 실제 중심선으로 맞춥니다."/>
        </StackPanel>

        <!-- ===== 본문: 왼쪽 벽 유형 / 오른쪽 레벨 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- 벽 유형 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="① 벽 유형" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="TypeCountText" Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                    <Button Grid.Column="2" x:Name="ClearTypesButton" Content="전체 해제" Padding="10,3"
                            Click="ClearTypesButton_Click"/>
                </Grid>

                <TextBox Grid.Row="1" x:Name="TypeSearchBox" Margin="0,0,0,6" Padding="6,4"
                         TextChanged="TypeSearchBox_TextChanged"/>

                <Border Grid.Row="2" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                        CornerRadius="3" Background="{DynamicResource SurfaceBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TypeListPanel" Margin="2"/>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- 레벨 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="② 레벨" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="LevelCountText" Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                    <Button Grid.Column="2" x:Name="ClearLevelsButton" Content="전체 해제" Padding="10,3"
                            Click="ClearLevelsButton_Click"/>
                </Grid>

                <TextBlock Grid.Row="1" Margin="0,0,0,6" TextWrapping="Wrap" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="고른 레벨마다 그 레벨의 평면뷰에 구분선을 만듭니다. 평면뷰가 없는 레벨은 건너뜁니다."/>

                <Border Grid.Row="2" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                        CornerRadius="3" Background="{DynamicResource SurfaceBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="LevelListPanel" Margin="2"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== 옵션 ===== -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="12" CornerRadius="3"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
            <StackPanel>
                <CheckBox x:Name="IncludeLinksCheck" IsChecked="True" Content="링크된 모델의 벽도 포함"/>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="링크 모델은 레벨 이름이 달라도 됩니다 - 링크의 레벨 높이를 이 모델 좌표로 환산해 같은 높이(±300mm)의 레벨로 맞춥니다. 만들어지는 구분선은 언제나 이 모델에 생깁니다."/>
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="이미 있는 구분선은 지우지 않고 그대로 두고 새로 추가합니다. 같은 조건으로 여러 번 실행하면 같은 자리에 선이 겹쳐 쌓이니, 되돌리려면 Revit의 실행 취소(Ctrl+Z)를 쓰세요."/>
            </StackPanel>
        </Border>

        <!-- ===== 푸터 ===== -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="취소" Padding="20,6" Margin="0,0,8,0" Click="CancelButton_Click" IsCancel="True"/>
                <Button x:Name="CreateButton" Content="구분선 만들기" Padding="24,6" Click="CreateButton_Click"
                        IsDefault="True" Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
