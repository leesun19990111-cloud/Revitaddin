<Window x:Class="WallSplitter.LinkedModelPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="링크된 모델"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        SizeToContent="Height"
        Width="300"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <ResourceDictionary Source="/WallSplitter;component/Resources/Theme.xaml"/>
    </Window.Resources>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4">
        <StackPanel Margin="10">
            <TextBlock x:Name="TitleText" FontWeight="Bold" Margin="0,0,0,2"/>
            <TextBlock x:Name="HintText" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <StackPanel x:Name="AllButtonsPanel" Orientation="Horizontal" Margin="0,0,0,8"/>
            <!-- 링크가 많아도 창이 화면을 넘지 않도록 목록만 스크롤한다. -->
            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="LinkListPanel"/>
            </ScrollViewer>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="CloseButton" Content="닫기" Padding="14,4" Click="CloseButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
