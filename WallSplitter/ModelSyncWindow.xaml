<Window x:Class="WallSplitter.ModelSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="모델간 변경 반영 - 변경사항 내보내기/적용"
        Height="700" Width="860"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">
    <!-- 다크 테마는 이 창의 Resources에만 로컬로 병합한다 - Application 리소스에 병합하면 Revit 리본/다른
         애드인 UI까지 우리 스타일이 번져 텍스트가 하얗게 되는 라이브 버그가 있었다(NamerWindow.xaml 참고). -->
    <Window.Resources>
        <ResourceDictionary Source="/WallSplitter;component/Resources/Theme.xaml"/>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="140"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="NAMER/재료 지정에서 최종 적용된 변경사항이 자동으로 쌓인 기록입니다. 선택한 항목을 파일로 내보내거나, 파일에서 가져오거나, 같은 세션에 열려 있는 다른 문서에 바로 적용할 수 있습니다."/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="필터:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="FilterBox" Width="220" VerticalContentAlignment="Center" TextChanged="FilterBox_TextChanged"/>
            <Button Content="전체 선택" Margin="14,0,0,0" Click="SelectAllButton_Click"/>
            <Button Content="전체 해제" Margin="6,0,0,0" Click="SelectNoneButton_Click"/>
            <Button Content="내보내기..." Margin="14,0,0,0" Click="ExportButton_Click"/>
            <Button Content="가져오기..." Margin="6,0,0,0" Click="ImportButton_Click"/>
            <Button Content="선택 항목 로그에서 삭제" Margin="6,0,0,0" Click="DeleteButton_Click"/>
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ItemsPanel" Margin="4"/>
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="CountText" Grid.Row="3" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,10"/>

        <Border Grid.Row="4" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="적용 대상 문서 (같은 세션에 열려 있는 문서만 표시됩니다)"
                           FontWeight="Bold" Margin="6,6,6,4"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="TargetDocsPanel" Margin="6"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="적용 시 이름/유형/재료가 대상 문서에서 정확히 하나만 매칭되면 자동으로 적용되고, 0개나 여러 개면 직접 고르는 창이 뜹니다 (재료 삭제는 안전을 위해 대상이 없으면 그냥 건너뜁니다)."/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소" Padding="18,5" Margin="0,0,8,0" Click="CancelButton_Click" IsCancel="True"/>
            <Button Content="선택 항목 적용" Padding="18,5" Click="ApplyButton_Click" FontWeight="Bold" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
