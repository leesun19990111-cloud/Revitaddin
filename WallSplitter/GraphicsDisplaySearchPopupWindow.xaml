<Window x:Class="WallSplitter.GraphicsDisplaySearchPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="그래픽 화면표시 검색"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        Height="500"
        Width="410"
        WindowStartupLocation="Manual"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary Source="/WallSplitter;component/Resources/Theme.xaml"/>
    </Window.Resources>
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="4">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" Grid.Row="0" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
            <TextBlock x:Name="ViewText" Grid.Row="1" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBox x:Name="SearchBox" Grid.Row="2" Height="30" Padding="7,4"
                     VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"
                     ToolTip="모델 또는 주석 카테고리 이름을 입력하세요"/>

            <Border Grid.Row="3" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                    CornerRadius="3" Margin="0,8,0,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ResultsPanel" Margin="4"/>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="4">
                <TextBlock x:Name="ResultCountText" Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <Button Content="닫기" HorizontalAlignment="Right" Padding="14,4"
                        Click="CloseButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
