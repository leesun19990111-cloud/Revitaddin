<Window x:Class="WallSplitter.PatternPunchWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sunny Tools · 패턴 타공"
        Width="1220" Height="800" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="PanelBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="기준 패턴" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="PatternNameText" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="PatternInfoText" Grid.Column="1" Margin="18,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Border Grid.Column="2" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Padding="8,4">
                    <TextBlock x:Name="SelectionStateText" Text="타공 영역을 직접 선택하세요"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="245"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="285"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Padding="0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="12">
                        <TextBlock Text="선택한 면" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="첫 번째 면과 같은 패턴을 사용하는 대상입니다." Margin="0,5,0,0"
                                   TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <ListBox x:Name="TargetList" Margin="4" SelectionChanged="TargetList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding CategoryLabel}" Margin="0,3,0,0" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns"/>

            <Border Grid.Column="2" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Background="#FAFAFA">
                <TabControl x:Name="PreviewTabs" SelectionChanged="PreviewTabs_SelectionChanged">
                    <TabItem Header="타공 영역 직접 선택">
                        <Grid Background="#FAFAFA">
                            <Canvas x:Name="SelectionCanvas" Background="#FAFAFA" ClipToBounds="True"
                                    SizeChanged="PreviewCanvas_SizeChanged"/>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="8,5"
                                    Background="#E6F2F2F3" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                                <TextBlock Text="뚫을 영역을 하나씩 클릭하세요. 다시 클릭하면 선택이 해제됩니다." FontSize="11"/>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem Header="선택 결과 보기">
                        <Grid Background="#FAFAFA">
                            <Canvas x:Name="FullCanvas" Background="#FAFAFA" ClipToBounds="True"
                                    SizeChanged="PreviewCanvas_SizeChanged"/>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Padding="8,5"
                                    Background="#E6F2F2F3" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                                <TextBlock Text="파랑: 정상 타공 · 주황: 경계 잘라내기 · 빨강: 검증 오류" FontSize="11"/>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns"/>

            <Border Grid.Column="4" Style="{StaticResource PanelBorderStyle}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="타공 설정" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <CheckBox x:Name="MinimumSizeCheckBox" Content="최소 타공 크기 사용"
                                  Checked="Option_Changed" Unchecked="Option_Changed"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="24"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="최소 폭" VerticalAlignment="Center"/>
                            <TextBox x:Name="MinimumWidthBox" Grid.Column="1" Text="10" IsEnabled="False"
                                     TextChanged="Option_Changed" HorizontalContentAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="mm" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Text="최소 높이" VerticalAlignment="Center"/>
                            <TextBox x:Name="MinimumHeightBox" Grid.Row="2" Grid.Column="1" Text="10" IsEnabled="False"
                                     TextChanged="Option_Changed" HorizontalContentAlignment="Right"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="mm" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,14"/>
                        <TextBlock Text="예상 결과" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="CountText" Text="타공할 폐영역을 직접 선택하면 계산됩니다." TextWrapping="Wrap"/>
                        <TextBlock x:Name="ComplexityText" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <Button x:Name="ValidateButton" Content="형상 사전 검증" Margin="0,18,0,0" Padding="12,7"
                                Click="ValidateButton_Click"/>
                        <TextBlock x:Name="ValidationText" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,12"/>
                        <TextBlock Text="적용 규칙" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="선택 면에 수직으로 완전 관통합니다. 경계에 걸린 패턴은 면 외곽에 맞춰 잘라내며, 기존 개구부는 보존합니다."/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource PanelBorderStyle}" Padding="12,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Button Grid.Column="1" Content="취소" Padding="18,7" Click="CancelButton_Click"/>
                <Button x:Name="RunButton" Grid.Column="3" Content="타공 실행" Padding="20,7"
                        Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False" Click="RunButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
