<Project Sdk="Microsoft.NET.Sdk">

  <!-- Revit 2023~2027 동시 지원을 위한 연도별 빌드 구성.
       Configuration 이름 뒤 4자리(예: Release2026)에서 연도를 뽑아 그 연도에 맞는
       TargetFramework + Nice3point.Revit.Api 패키지 버전을 고른다.
       (실측 확인: 2023/2024 -> net48, 2025/2026 -> net8.0-windows, 2027 -> net10.0-windows) -->
  <PropertyGroup>
    <Configurations>Debug2023;Debug2024;Debug2025;Debug2026;Debug2027</Configurations>
    <Configurations>$(Configurations);Release2023;Release2024;Release2025;Release2026;Release2027</Configurations>
  </PropertyGroup>

  <PropertyGroup>
    <RevitVersion Condition="$(Configuration.EndsWith('2023'))">2023</RevitVersion>
    <RevitVersion Condition="$(Configuration.EndsWith('2024'))">2024</RevitVersion>
    <RevitVersion Condition="$(Configuration.EndsWith('2025'))">2025</RevitVersion>
    <RevitVersion Condition="$(Configuration.EndsWith('2026'))">2026</RevitVersion>
    <RevitVersion Condition="$(Configuration.EndsWith('2027'))">2027</RevitVersion>
    <!-- 연도 접미사가 없는 일반 Debug/Release(예: IDE 기본값)로 빌드할 경우를 위한 안전한 기본값 -->
    <RevitVersion Condition="'$(RevitVersion)'==''">2026</RevitVersion>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework Condition="'$(RevitVersion)'=='2023' or '$(RevitVersion)'=='2024'">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)'=='2025' or '$(RevitVersion)'=='2026'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)'=='2027'">net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- net48은 기본 C# 7.3으로 잡혀 nullable 등 최신 문법을 못 씀 -->
    <LangVersion>latest</LangVersion>
    <!-- 리본 버튼 아이콘(BitmapSource)을 로드하기 위해 필요. net48/net8.0-windows/net10.0-windows 모두 지원. -->
    <UseWPF>true</UseWPF>
    <!-- Revit은 클래스 라이브러리의 .deps.json을 따라 NuGet 런타임 DLL을 찾아주지 않는다.
         net8/net10 클래스 라이브러리 기본값(false)에 맡기면 Clipper2Lib.dll이 출력에서 빠져
         명령 시작 전에 FileNotFoundException이 발생하므로 모든 연도에서 명시적으로 복사한다. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- 연도별 API 차이가 실제로 발견된 경우에만 추가하는 조건부 컴파일 상수 (Nice3point SDK의 OR_GREATER
       네이밍을 그대로 따르되, 실제 쓰는 것만 손으로 추가). 첫 사례: Floor.SlabShapeEditor가 2023에서는
       프로퍼티, 2024부터는 GetSlabShapeEditor() 메서드로 바뀜(2024/2025는 과도기라 둘 다 존재,
       2026부터는 메서드만) - MetadataLoadContext로 5개 연도 패키지를 모두 리플렉션해 직접 확인함. -->
  <PropertyGroup>
    <DefineConstants Condition="'$(RevitVersion)'=='2023'">$(DefineConstants);REVIT2023</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)'=='2024' or '$(RevitVersion)'=='2025' or '$(RevitVersion)'=='2026' or '$(RevitVersion)'=='2027'">$(DefineConstants);REVIT2024_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <!-- CONFIRMED LIVE BUG (2026-07-27, 2026-08-21 재확인): 아래의 예전 방식(연도 전체를 "$(RevitVersion).*-*"로 열어두어
       NuGet이 그 연도의 "가장 최신" 패치를 고르게 하는 방식)은 Nice3point 패키지가 새 핫픽스를 내놓는
       순간, 이 PC에 실제로 설치된 Revit의 RevitAPI.dll/RevitAPIUI.dll 파일 버전보다 앞서가 버릴 수 있다.
       2026-07-27에는 2026.4.10 패키지가 restore되어 있었는데 이 PC의 Revit API는 26.4.0.32였고,
       반대로 2026-08-21 Revit 업데이트 뒤에는 실제 API가 26.4.10.51(Assembly 26.4.10.0)이 되었는데
       v51 애드인이 예전 26.4.0.0을 참조해 같은 충돌이 재발했다. 이 버전 불일치는 API 호출에서는 안 터지다가,
       WPF 창의 InitializeComponent()(BAML 로드) 시점에만 "Assembly version conflict" 경고와 함께
       XamlParseException으로 터졌다(NAMER/재료 지정/모델간 변경 반영/빠른 토글 설정 - 즉 창을 여는
       커맨드 전부, Revit 저널의 스택트레이스로 실측 확인). 벽체 분리(기본 템플릿 모드)는 창을 안 열어서
       증상이 없었을 뿐, 근본 원인은 같았다. 그래서 각 연도를 그 연도에 실제로 설치된 Revit의 API 버전과
       정확히 맞는 패키지 버전으로 고정한다(설치 여부를 확인할 수 있는 연도만) - 와일드카드로 열어두지
       않는다. 이 PC의 2023/2026은 정확한 Nice3point 패키지로 고정한다. 2027도 설치본 27.1.0.0과 같은
       2027.1.0 패키지로 고정한다. 2024 설치본은 24.3.10.0인데 NuGet에는 같은 버전이 없으므로, 이 PC에서
       Release2024를 만들 때만 설치 폴더의 RevitAPI/RevitAPIUI를 컴파일 참조로 사용한다(Private=false).
       설치본이 없는 빌드 머신에서는 2024.3.60 패키지로 fallback하되, 그 산출물은 설치 API 대조 없이는
       배포하지 않는다. 2025는 이 PC에 설치되지 않아 최신 검증 가능 패키지를 사용한다. -->
  <PropertyGroup>
    <Revit2024InstallDir Condition="'$(Revit2024InstallDir)'==''">C:\Program Files\Autodesk\Revit 2024</Revit2024InstallDir>
    <UseLocalRevit2024Api Condition="'$(RevitVersion)'=='2024' and Exists('$(Revit2024InstallDir)\RevitAPI.dll') and Exists('$(Revit2024InstallDir)\RevitAPIUI.dll')">true</UseLocalRevit2024Api>
    <RevitApiPackageVersion Condition="'$(RevitVersion)'=='2023'">2023.1.90</RevitApiPackageVersion>
    <RevitApiPackageVersion Condition="'$(RevitVersion)'=='2024'">2024.3.60</RevitApiPackageVersion>
    <RevitApiPackageVersion Condition="'$(RevitVersion)'=='2026'">2026.4.10</RevitApiPackageVersion>
    <RevitApiPackageVersion Condition="'$(RevitVersion)'=='2027'">2027.1.0</RevitApiPackageVersion>
    <RevitApiPackageVersion Condition="'$(RevitApiPackageVersion)'==''">$(RevitVersion).*-*</RevitApiPackageVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseLocalRevit2024Api)'=='true'">
    <Reference Include="RevitAPI">
      <HintPath>$(Revit2024InstallDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(Revit2024InstallDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Revit 설치 여부와 무관하게 빌드 가능하도록 NuGet 참조 어셈블리 패키지 사용.
         ref/ 폴더 전용 패키지라 컴파일 전용이며 출력 폴더로 복사되지 않는다(Autodesk DLL 재배포 방지). -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitApiPackageVersion)" Condition="'$(UseLocalRevit2024Api)'!='true'" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitApiPackageVersion)" Condition="'$(UseLocalRevit2024Api)'!='true'" />
    <!-- 패턴 타공의 경계 잘라내기/중복 합치기/폐영역 검증을 정수 좌표 기반으로 안정적으로 처리한다.
         netstandard2.0 단일 DLL이라 Revit 2023(net48)부터 2027까지 같은 코드로 사용할 수 있다. -->
    <PackageReference Include="Clipper2" Version="2.0.0" />
    <!-- net48에는 System.Text.Json이 기본 내장되어 있지 않아 설정 파일(JSON) 저장/로드를 위해 명시적으로 참조 -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

