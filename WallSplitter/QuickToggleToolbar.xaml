<Window x:Class="WallSplitter.QuickToggleToolbar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sunny Tools 커스텀 버튼"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        Topmost="False">
    <!-- Revit 메인 창을 따라다니되 사용자가 마우스로 직접 드래그해 위치를 옮길 수 있는 커스텀 툴바
         (실제 QAT API는 없어 자체 창으로 구현 - CLAUDE.md 참고).
         CONFIRMED LIVE BUG (2026-07-27), 두 번째 수정: 처음엔 "빈 배경 아무 곳이나 누르면 드래그"였는데,
         실측 결과 버튼 사이의 빈 공간이 창을 내용 크기에 딱 맞게 줄이다 보니(SizeToContent) 실질적으로
         거의 없어져서 "드래그가 아예 안 된다"는 보고, 그리고 그 좁은 틈과 버튼 경계가 애매해서 "버튼 클릭이
         잘 안 잡힌다"는 보고가 동시에 들어왔다 - 사실상 같은 원인(드래그용 여백과 버튼 클릭 영역이 서로
         너무 가깝고 좁음)이었다. 고정: 왼쪽에 항상 존재하는 전용 그립(DragGrip, 점 3개, 항상 16px 너비)을
         따로 두어 드래그는 거기서만 하고, 버튼이 있는 영역(ButtonsPanel)에는 더 이상 드래그 핸들러를 두지
         않는다 - 버튼 개수·창 너비와 무관하게 "여기를 잡으면 옮길 수 있다"는 위치가 항상 고정으로 보장된다.
         다크 테마는 이 창의 Resources에만 로컬로 병합한다 - Application 리소스에 병합하면 Revit 리본/다른
         애드인 UI까지 우리 스타일이 번져 텍스트가 하얗게 되는 라이브 버그가 있었다(NamerWindow.xaml 참고). -->
    <Window.Resources>
        <ResourceDictionary Source="/WallSplitter;component/Resources/Theme.xaml"/>
    </Window.Resources>
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 전용 드래그 그립 - 항상 이 너비만큼은 배경이 보장되므로, 버튼이 몇 개든 창이 아무리
                 좁든 여기를 누르면 확실히 옮길 수 있다. 2026-07-27, "잡을 수 있는 픽셀이 너무 작아서
                 잡기 힘들다"는 피드백으로 16px→28px로 넓혔다(QuickToggleToolbar.xaml.cs의
                 GripWidthDip과 반드시 맞춰야 함) - 점 3개 자체도 함께 키워서 넓어진 영역과 비례가 맞게 했다.
                 CONFIRMED LIVE BUG (2026-07-27), 추가 수정 - "점 세개에 정확히 마우스를 가져다 대야만
                 움직여진다": 이 Border에 Background를 지정하지 않아서(기본값 null) 빈 영역은 히트테스트가
                 안 됐다 - 실제로 클릭이 되는 곳은 점 3개(Rectangle) 자신의 아주 작은 영역뿐이었다.
                 Background="Transparent"를 명시하면(투명해도 히트테스트는 됨) 28px 너비 전체, 행 높이
                 전체가 클릭 가능해진다. -->
            <Border Grid.Column="0" Width="28" Background="Transparent" Cursor="SizeAll"
                    ToolTip="눌러서 드래그하면 위치를 옮길 수 있습니다."
                    MouseLeftButtonDown="DragGrip_MouseLeftButtonDown">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                    <Rectangle Width="4" Height="4" Fill="{DynamicResource TextSecondaryBrush}" Margin="0,2.5"/>
                    <Rectangle Width="4" Height="4" Fill="{DynamicResource TextSecondaryBrush}" Margin="0,2.5"/>
                    <Rectangle Width="4" Height="4" Fill="{DynamicResource TextSecondaryBrush}" Margin="0,2.5"/>
                </StackPanel>
            </Border>

            <!-- 2026-07-27, 사용자 요청으로 가로 스크롤을 없앴다 - "스크롤이 너무 짧아서 잡기 힘들고
                 반대로 되는 느낌"이라는 피드백. 이제 버튼이 많아지면 ResizeToContent()가 창 자체를
                 그만큼 옆으로 늘린다(더 이상 최대 너비 제한 없음) - QuickToggleToolbar.xaml.cs 참고. -->
            <StackPanel Grid.Column="1" x:Name="ButtonsPanel" Orientation="Horizontal" Margin="4"/>

            <!-- 등록된 버튼 목록과 무관하게 항상 우측 끝에 고정되는 자리. ResizeToContent()가 이 패널도
                 함께 측정해서 창 너비에 반영한다.
                 2026-09-03, 사용자 요청("현재뷰 저장 버튼 및 되돌리기 버튼을 없애주고 그자리에 톱니바퀴
                 버튼을 추가해서 바로 커스텀 버튼 설정창을 갈 수 있도록")으로 예전의 "뷰 저장"/"되돌리기"
                 버튼 쌍을 설정(톱니바퀴) 버튼 하나로 교체했다 - 그 두 기능의 구현 코드도 함께 지웠다
                 (docs/quick-toggle/CLAUDE.md 참고). -->
            <StackPanel Grid.Column="2" x:Name="RightControlsPanel" Orientation="Horizontal" Margin="0,4,4,4">
                <Border Width="1" Margin="4,2" Background="{DynamicResource AppBorderBrush}"/>
                <Button x:Name="SettingsButton" Width="28" Height="28" Padding="4"
                        ToolTip="커스텀 버튼 설정 창을 엽니다."
                        Click="SettingsButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
