<Window x:Class="WallSplitter.QuickToggleToolbar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sunny Tools 빠른 토글"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        Topmost="False">
    <!-- Revit 메인 창을 따라다니되 사용자가 마우스로 직접 드래그해 위치를 옮길 수 있는 커스텀 툴바
         (실제 QAT API는 없어 자체 창으로 구현 - CLAUDE.md 참고). 원래는 고정 위치였으나 "기존 리본 버튼을
         가린다"는 실측 피드백(2026-07-27)으로 드래그 가능하게 바꿨다 - RootBorder의 빈 영역(버튼이 없는
         부분)을 누른 채 끌면 DragMove()로 창을 옮기고, 놓는 순간 Revit 메인 창 기준 오프셋으로 저장한다
         (QuickToggleToolbar.xaml.cs 참고). 다크 테마는 이 창의 Resources에만 로컬로 병합한다 - Application
         리소스에 병합하면 Revit 리본/다른 애드인 UI까지 우리 스타일이 번져 텍스트가 하얗게 되는 라이브
         버그가 있었다(NamerWindow.xaml 참고). -->
    <Window.Resources>
        <ResourceDictionary Source="/WallSplitter;component/Resources/Theme.xaml"/>
    </Window.Resources>
    <Border x:Name="RootBorder"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Cursor="SizeAll"
            ToolTip="빈 곳을 눌러서 드래그하면 위치를 옮길 수 있습니다."
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" Margin="4"/>
        </ScrollViewer>
    </Border>
</Window>
