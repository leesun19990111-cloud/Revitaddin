<Window x:Class="WallSplitter.ColorToolPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="색상/투명도"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        SizeToContent="Height"
        Width="250"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <ResourceDictionary Source="/WallSplitter;component/Resources/Theme.xaml"/>
    </Window.Resources>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4">
        <StackPanel x:Name="RootPanel" Margin="10"/>
    </Border>
</Window>
