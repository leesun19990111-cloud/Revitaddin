<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SunnyTools_Install</AssemblyName>
    <RootNamespace>SunnyToolsInstaller</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- 게시 결과 폴더에 .NET 런타임 dll 수십 개가 exe와 함께 흩어져 있으면 실행 파일을 찾기 어렵다는 피드백으로 추가.
         단일 파일 게시(self-contained + PublishSingleFile)로 묶으면 그 dll들이 exe 안에 번들되어
         결과 폴더에는 exe(+ 소수의 네이티브 파일)와 Payload\ 폴더만 남는다. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- WallSplitter.csproj를 지원 대상 Revit 연도(2023~2027) 수만큼 각각 빌드해서
       Payload\{연도}\ 아래로 모아온다.
       ProjectReference를 쓰지 않는 이유: WallSplitter.csproj는 UseWPF=true(리본 아이콘용)라서
       일반 ProjectReference로 걸면 self-contained 게시 시 WPF 네이티브 런타임 전체가
       설치 프로그램에도 딸려와 크기가 5배 이상 불어난다. 설치 프로그램 자신은 DLL을
       파일로 복사만 할 뿐 실제로 로드/실행하지 않으므로 순수 데이터로만 가져온다.

       WallSplitter.dll 하나만이 아니라 해당 출력 폴더의 *.dll 전부를 복사한다:
       net48(2023/2024) 빌드는 System.Text.Json 등 net48에 기본 내장되지 않은 의존 DLL이
       같은 폴더에 함께 생성되며, 이것들도 Revit Addins 폴더에 같이 있어야 로드에 성공한다
       net8.0-windows/net10.0-windows도 패턴 형상 연산용 Clipper2Lib.dll이 필요하므로,
       와일드카드로 모든 런타임 DLL을 함께 가져와야 한다. -->
  <!-- 기존 Release obj DLL이 Revit/백신 등에 메모리 매핑되어 잠긴 경우, 호출자가 각 연도 Release 빌드를
       별도 IntermediateOutputPath에 먼저 만든 뒤 이 단계만 건너뛰고 게시할 수 있다. 그 경우 게시 후
       검증된 DLL을 Payload에 명시적으로 덮어써야 한다(docs/installer/CLAUDE.md). -->
  <Target Name="BuildWallSplitterPayload" BeforeTargets="Build;Publish"
          Condition="'$(SkipWallSplitterPayloadBuild)' != 'true'">
    <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)..\WallSplitter\WallSplitter.csproj&quot; -c Release2023 -v quiet" />
    <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)..\WallSplitter\WallSplitter.csproj&quot; -c Release2024 -v quiet" />
    <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)..\WallSplitter\WallSplitter.csproj&quot; -c Release2025 -v quiet" />
    <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)..\WallSplitter\WallSplitter.csproj&quot; -c Release2026 -v quiet" />
    <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)..\WallSplitter\WallSplitter.csproj&quot; -c Release2027 -v quiet" />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\WallSplitter\bin\Release2023\net48\Clipper2Lib.dll')" Text="Revit 2023 Payload에 Clipper2Lib.dll이 없습니다." />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\WallSplitter\bin\Release2024\net48\Clipper2Lib.dll')" Text="Revit 2024 Payload에 Clipper2Lib.dll이 없습니다." />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\WallSplitter\bin\Release2025\net8.0-windows\Clipper2Lib.dll')" Text="Revit 2025 Payload에 Clipper2Lib.dll이 없습니다." />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\WallSplitter\bin\Release2026\net8.0-windows\Clipper2Lib.dll')" Text="Revit 2026 Payload에 Clipper2Lib.dll이 없습니다." />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\WallSplitter\bin\Release2027\net10.0-windows\Clipper2Lib.dll')" Text="Revit 2027 Payload에 Clipper2Lib.dll이 없습니다." />

    <!-- 위 빌드 중 처음 생긴 DLL은 프로젝트 평가 시점의 정적 *.dll 항목에 잡히지 않을 수 있다.
         빌드가 끝난 뒤 항목을 다시 열거해 OutDir Payload에 직접 복사하면 깨끗한 최초 게시도 누락되지 않는다. -->
    <ItemGroup>
      <FreshPayload2023 Include="$(MSBuildThisFileDirectory)..\WallSplitter\bin\Release2023\net48\*.dll" />
      <FreshPayload2024 Include="$(MSBuildThisFileDirectory)..\WallSplitter\bin\Release2024\net48\*.dll" />
      <FreshPayload2025 Include="$(MSBuildThisFileDirectory)..\WallSplitter\bin\Release2025\net8.0-windows\*.dll" />
      <FreshPayload2026 Include="$(MSBuildThisFileDirectory)..\WallSplitter\bin\Release2026\net8.0-windows\*.dll" />
      <FreshPayload2027 Include="$(MSBuildThisFileDirectory)..\WallSplitter\bin\Release2027\net10.0-windows\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(FreshPayload2023)" DestinationFiles="@(FreshPayload2023->'$(OutDir)Payload\2023\%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(FreshPayload2024)" DestinationFiles="@(FreshPayload2024->'$(OutDir)Payload\2024\%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(FreshPayload2025)" DestinationFiles="@(FreshPayload2025->'$(OutDir)Payload\2025\%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(FreshPayload2026)" DestinationFiles="@(FreshPayload2026->'$(OutDir)Payload\2026\%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(FreshPayload2027)" DestinationFiles="@(FreshPayload2027->'$(OutDir)Payload\2027\%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
  </Target>

  <ItemGroup>
    <None Include="..\WallSplitter\bin\Release2023\net48\*.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="Payload\2023\%(Filename)%(Extension)" Visible="false" />
    <None Include="..\WallSplitter\bin\Release2024\net48\*.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="Payload\2024\%(Filename)%(Extension)" Visible="false" />
    <None Include="..\WallSplitter\bin\Release2025\net8.0-windows\*.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="Payload\2025\%(Filename)%(Extension)" Visible="false" />
    <None Include="..\WallSplitter\bin\Release2026\net8.0-windows\*.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="Payload\2026\%(Filename)%(Extension)" Visible="false" />
    <None Include="..\WallSplitter\bin\Release2027\net10.0-windows\*.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="Payload\2027\%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

  <!-- PublishSingleFile 번들러는 (관리 어셈블리가 아닌) 순수 콘텐츠 파일인 Payload\를 게시 출력 폴더로
       복사하지 않고 중간 산출물(OutDir, 즉 bin\...\)에만 남겨둔다. 게시할 때마다 빠뜨리지 않도록
       게시 후 명시적으로 다시 복사한다. -->
  <Target Name="CopyPayloadToPublishDir" AfterTargets="Publish">
    <ItemGroup>
      <PayloadFiles Include="$(OutDir)Payload\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PayloadFiles)" DestinationFiles="@(PayloadFiles->'$(PublishDir)Payload\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
