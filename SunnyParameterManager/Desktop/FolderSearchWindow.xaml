<Window x:Class="SunnyParameterManager.Desktop.FolderSearchWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="폴더에서 RVT 찾기" Width="960" Height="740" MinWidth="800" MinHeight="640"
 WindowStartupLocation="CenterOwner" Background="#F2F2F3" FontFamily="Segoe UI" FontSize="13" Closing="WindowClosing">
 <Grid Margin="18" Background="#F2F2F3">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="여러 폴더에서 필요한 RVT만 찾기" FontSize="23" FontWeight="SemiBold" Foreground="#243A50"/>
   <TextBlock Text="검색 중에는 Revit을 열지 않습니다. 파일명과 전체 경로를 확인한 뒤 체크한 파일만 추가하세요." TextWrapping="Wrap" Margin="0,7,0,14" Foreground="#526474"/>
  </StackPanel>
  <StackPanel Grid.Row="1" x:Name="SearchControls">
   <WrapPanel Margin="0,0,0,8"><Button Content="폴더 추가 (여러 개 선택)" Click="AddFolders"/><Button Content="선택 폴더 제거" Click="RemoveFolders"/></WrapPanel>
   <ListBox x:Name="RootsList" Height="82" SelectionMode="Extended" Margin="0,0,0,10" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
   <DockPanel Margin="0,0,0,8"><TextBlock Text="파일명에 포함할 문자열" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="ContainsBox" TextChanged="CriteriaChanged" ToolTip="예: -SP, MWX, 여객터미널. 입력한 문자열 전체를 포함하는 파일명만 찾습니다. 영문 대소문자는 구분하지 않습니다."/></DockPanel>
   <TextBlock Text="예: -SP → 공간파일 / MWX → MWX가 포함된 파일. 폴더명이 아닌 파일명에서 검색합니다." TextWrapping="Wrap" Foreground="#687785" Margin="0,0,0,8"/>
   <WrapPanel Margin="0,0,0,10"><CheckBox x:Name="RecursiveBox" Content="하위 폴더 포함" IsChecked="True" Click="CriteriaChanged" Margin="0,0,20,0"/><CheckBox x:Name="ExcludeBackupsBox" IsChecked="True" Click="CriteriaChanged"><TextBlock Text="백업 제외 (.0001.rvt · _backup 폴더)"/></CheckBox></WrapPanel>
  </StackPanel>
  <DockPanel Grid.Row="2" Margin="0,0,0,10">
   <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button x:Name="SearchButton" Content="파일 찾기" Click="Search"/><Button x:Name="StopSearchButton" Content="검색 중지" Click="StopSearch" IsEnabled="False"/><Button x:Name="SelectAllButton" Content="전체 체크" Click="SelectAll"/><Button x:Name="ClearAllButton" Content="체크 해제" Click="ClearAll"/></StackPanel>
   <TextBlock x:Name="ResultCount" VerticalAlignment="Center" TextWrapping="Wrap"/>
  </DockPanel>
  <DataGrid Grid.Row="3" x:Name="CandidatesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True">
   <DataGrid.Columns>
    <DataGridTemplateColumn Header="선택" Width="55"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" Checked="CandidateChanged" Unchecked="CandidateChanged"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="파일명" Binding="{Binding Name}" Width="290"/>
    <DataGridTextColumn Header="전체 경로" Binding="{Binding Path}" Width="*" MinWidth="300"><DataGridTextColumn.CellStyle><Style TargetType="DataGridCell"><Setter Property="ToolTip" Value="{Binding Path}"/></Style></DataGridTextColumn.CellStyle></DataGridTextColumn>
   </DataGrid.Columns>
  </DataGrid>
  <TextBox Grid.Row="4" x:Name="SearchStatus" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="90" VerticalScrollBarVisibility="Auto" Margin="0,10,0,10" Text="폴더를 추가하고 파일명 검색어를 입력하세요."/>
  <Grid Grid.Row="5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="추가 후 파일 조회만 진행합니다. 값 변경·중앙 동기화는 별도 확인 후 실행합니다." TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="취소" Click="Cancel"/><Button x:Name="ConfirmButton" Content="체크한 파일 추가" Click="Confirm" IsEnabled="False"/></StackPanel></Grid>
 </Grid>
</Window>
