<Window x:Class="SunnyParameterManager.Desktop.LinkRemovalWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Sunny · 링크·가져오기 완전 제거" Width="1160" Height="850" MinWidth="960" MinHeight="740"
 Background="#F2F2F3" FontFamily="Segoe UI" FontSize="13" Closing="WindowClosing">
 <Grid Margin="18" Background="#F2F2F3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,12"><TextBlock Text="링크·가져오기 완전 제거" FontSize="23" FontWeight="SemiBold" Foreground="#942E2E"/>
   <TextBlock Text="① 모델 체크 → ② 삭제 영향 검사 → ③ 목록 확인 → 하단에서 삭제 승인" Margin="0,6,0,5"/>
   <TextBlock Text="언로드가 아닙니다. 링크 정의와 모든 배치를 제거합니다. 외부 원본 파일은 삭제하지 않습니다." TextWrapping="Wrap"/>
  </StackPanel>
  <DataGrid Grid.Row="1" x:Name="ModelsGrid" IsReadOnly="False" CanUserAddRows="False" AutoGenerateColumns="False">
   <DataGrid.Columns>
    <DataGridTemplateColumn Header="선택" Width="55"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="모델" Binding="{Binding Title}" Width="230" IsReadOnly="True"/>
    <DataGridTextColumn Header="전체 경로" Binding="{Binding Path}" Width="*" MinWidth="220" IsReadOnly="True"/>
    <DataGridTextColumn Header="검사 결과" Binding="{Binding Status}" Width="240" IsReadOnly="True"/>
   </DataGrid.Columns>
  </DataGrid>
  <DockPanel Grid.Row="2" Margin="0,10"><StackPanel x:Name="ScanActions" DockPanel.Dock="Left" Orientation="Horizontal">
   <Button Content="모델 전체 체크" Click="SelectAll"/><Button Content="체크 해제" Click="ClearAll"/><Button x:Name="ScanButton" Content="② 삭제 영향 검사" Click="ScanClick"/>
  </StackPanel><Button x:Name="StopTaskButton" DockPanel.Dock="Right" Content="작업중지" Click="RequestTaskStop" IsEnabled="False" Foreground="#9A3E44" BorderBrush="#A6595D" ToolTip="현재 파일 처리를 마친 뒤 다음 파일부터 중지합니다."/><TextBlock x:Name="SummaryText" Text="삭제할 모델을 체크하세요." VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
  <TabControl Grid.Row="3" x:Name="DetailsTabs"><TabItem Header="삭제 대상과 종속 요소">
   <DataGrid x:Name="DetailsGrid"><DataGrid.Columns>
    <DataGridTextColumn Header="모델" Binding="{Binding Model}" Width="160"/><DataGridTextColumn Header="분류" Binding="{Binding Kind}" Width="220"/>
    <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="230"/><DataGridTextColumn Header="요소 번호" Binding="{Binding ElementId}" Width="95"/>
    <DataGridTextColumn Header="카테고리" Binding="{Binding Category}" Width="130"/><DataGridTextColumn Header="고정" Binding="{Binding Pinned}" Width="55"/>
    <DataGridTextColumn Header="원본 참조 (삭제하지 않음)" Binding="{Binding Source}" Width="300"/>
   </DataGrid.Columns></DataGrid>
  </TabItem><TabItem Header="검사·처리 기록"><TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem></TabControl>
  <Border Grid.Row="4" BorderBrush="#C66B6B" BorderThickness="1" Background="#FFF5F5" Padding="12" Margin="0,12,0,0"><StackPanel>
   <TextBlock Text="Revit·CAD·가져오기·포인트 클라우드·이미지/PDF·조정 모델·지형·DWF 마크업 대상입니다. 고정된 항목도 삭제됩니다. 키노트·재료 텍스처 등 외부 설정, 패밀리 내부는 제외합니다." TextWrapping="Wrap" Foreground="#7D3030"/>
   <CheckBox x:Name="DependentApproval" Content="목록에 표시된 종속 요소(태그·치수 등)도 함께 삭제하는 데 동의합니다." Margin="0,8,0,4" Checked="ApprovalChanged" Unchecked="ApprovalChanged"/>
   <TextBlock Text="삭제 전 복구 파일을 보관합니다. 여러 모델은 순차 처리하며 앞서 저장된 모델은 자동으로 되돌리지 않습니다." TextWrapping="Wrap" Margin="0,0,0,7"/>
   <DockPanel><Button x:Name="DeleteButton" DockPanel.Dock="Right" Content="완전 삭제 · 저장 · 중앙 동기화" Background="#B62D32" Foreground="White" FontWeight="Bold" Click="DeleteClick" IsEnabled="False" Margin="12,0,0,0"/>
    <TextBlock Text="확인 문구: 모두 삭제" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="ConfirmText" TextChanged="ConfirmationChanged" MinWidth="160"/>
   </DockPanel>
  </StackPanel></Border>
 </Grid>
</Window>
